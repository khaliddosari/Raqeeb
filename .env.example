ROBOFLOW_API_KEY=

# --- Voice agent app (agent/) ---
# Provider selection -- swap to "openai" (once supported in agent/providers/factory.py)
# without touching any LangGraph/route code. TELEPHONY_PROVIDER: mock | twilio | signalwire
LLM_PROVIDER=mock
TELEPHONY_PROVIDER=mock

GEMINI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SignalWire (Twilio-compatible alternative) -- only needed if TELEPHONY_PROVIDER=signalwire
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PHONE_NUMBER=

# Publicly reachable base URL for this server (Twilio needs to call back into it for
# the voice webhook and media-stream websocket). e.g. an ngrok/cloud URL in production.
PUBLIC_BASE_URL=http://localhost:8000

DATABASE_URL=sqlite:///./raqeeb.db

# Per-class authority phone/endpoint overrides referenced from
# config/authority_mapping.yaml, e.g.:
# AUTHORITY_GUN_PHONE=+15551234567
# AUTHORITY_GUN_ENDPOINT=https://real-authority.example.com/api/incidents
