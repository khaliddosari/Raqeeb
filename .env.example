ROBOFLOW_API_KEY=

# --- Voice agent app (agent/) ---
# Provider selection. LLM_PROVIDER: mock | gemini | openai. TELEPHONY_PROVIDER: mock | twilio | signalwire.
# LLM_PROVIDER=openai bridges the authority call over OpenAI's SIP connector instead of
# our own Media Stream WebSocket -- see the OpenAI section below for the extra setup that needs.
LLM_PROVIDER=mock
TELEPHONY_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Only needed if LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_TEXT_MODEL=gpt-4o-mini
# Required for the SIP call flow: create a webhook at platform.openai.com -> your project
# -> Settings -> Webhooks, pointing at <PUBLIC_BASE_URL>/api/openai/webhook with event type
# realtime.call.incoming. OPENAI_PROJECT_ID is your proj_... ID; OPENAI_WEBHOOK_SECRET is
# the whsec_... signing secret shown when you create the webhook.
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SignalWire (Twilio-compatible alternative) -- only needed if TELEPHONY_PROVIDER=signalwire
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PHONE_NUMBER=

# Publicly reachable base URL for this server (Twilio needs to call back into it for
# the voice webhook and media-stream websocket). e.g. an ngrok/cloud URL in production.
PUBLIC_BASE_URL=http://localhost:8000

DATABASE_URL=sqlite:///./raqeeb.db

# Per-class authority phone/endpoint overrides referenced from
# config/authority_mapping.yaml, e.g.:
# AUTHORITY_GUN_PHONE=+966500000000
# AUTHORITY_GUN_ENDPOINT=https://real-authority.example.com/api/incidents
