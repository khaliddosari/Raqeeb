{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/passes",
      "destination": "/passes/index.html"
    },
    {
      "source": "/passes/",
      "destination": "/passes/index.html"
    },
    {
      "source": "/poster",
      "destination": "/poster/index.html"
    },
    {
      "source": "/poster/",
      "destination": "/poster/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
